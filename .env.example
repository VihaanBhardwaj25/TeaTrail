# Copy to .env for local development. Streamlit secrets take precedence over these values.

APP_PASSCODE=change-me

# Public Google Sheet link (defaults to the TeaTrail FAQ sheet; "sample" = built-in FAQs only)
# FAQ_SHEET_CSV_URL=

# auto | anthropic | openai | gemini | offline
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low
# ANTHROPIC_FALLBACKS=on
# DATA_DIR=data
