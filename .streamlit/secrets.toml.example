# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud → your app → Settings → Secrets.

APP_PASSCODE = "change-me"          # passcode for the lock screen

# Google Sheet with columns category, question, answer. Defaults to the TeaTrail FAQ sheet;
# set to "sample" to use only the built-in FAQs.
# FAQ_SHEET_CSV_URL = ""

# LLM: auto picks the first key it finds (Anthropic → OpenAI → Gemini); none = offline FAQ mode
LLM_PROVIDER = "auto"               # auto | anthropic | openai | gemini | offline
ANTHROPIC_API_KEY = ""
OPENAI_API_KEY = ""
GEMINI_API_KEY = ""
# LLM_MODEL = "claude-opus-5-5"     # optional override of the provider's default model
# LLM_EFFORT = "low"                # Claude effort level; "none" to omit (for older models)
# ANTHROPIC_FALLBACKS = "on"        # server-side refusal fallback on Claude
